rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // DEFAULT DENY BACKSTOP
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================================
    // CIRCLE PROTOCOL V2 — Server-authoritative, owner-bound community feed
    // Collection: circle_v2
    // =====================================================================
    match /circle_v2/{postId} {
      // Shared read across authenticated circle members
      allow read: if request.auth != null;

      // Create: Owner-bound creation. Caller MUST authenticate and match ownerUid.
      // Payload is strictly validated with bounded fields.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['ownerUid', 'authorAlias', 'body', 'createdAt', 'status'])
                    && request.resource.data.keys().hasOnly(['ownerUid', 'authorAlias', 'body', 'createdAt', 'status', 'kind', 'shapeJson', 'needsSupport'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 480
                    && request.resource.data.authorAlias is string
                    && request.resource.data.authorAlias.size() > 0
                    && request.resource.data.authorAlias.size() <= 32
                    && request.resource.data.createdAt is int
                    && request.resource.data.status == 'visible';

      // Update: Immutable posts. Denies arbitrary body, status, or unrelated field modification.
      allow update: if false;

      // Delete: Strictly owner-bound deletion.
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      // Reactions subcollection: Path and docId bind to actorUid + kind.
      // Only approved kinds ('strength', 'proud', 'respect') are accepted.
      // Updating is denied to prevent actor/kind modification or counter inflation.
      match /reactions/{reactionId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.kind in ['strength', 'proud', 'respect']
                      && reactionId == request.auth.uid + '_' + request.resource.data.kind
                      && request.resource.data.keys().hasAll(['actorUid', 'kind', 'createdAt'])
                      && request.resource.data.keys().hasOnly(['actorUid', 'kind', 'createdAt'])
                      && request.resource.data.createdAt is int;

        allow update: if false;

        allow delete: if request.auth != null
                      && resource.data.actorUid == request.auth.uid;
      }

      // Reports subcollection: Client cannot read reports; reporters can only create their own.
      // Bounded validated payloads.
      match /reports/{reporterUid} {
        allow read: if false;

        allow create: if request.auth != null
                      && reporterUid == request.auth.uid
                      && request.resource.data.reporterUid == request.auth.uid
                      && request.resource.data.keys().hasAll(['reporterUid', 'reasonCode', 'createdAt'])
                      && request.resource.data.keys().hasOnly(['reporterUid', 'reasonCode', 'createdAt', 'notes'])
                      && request.resource.data.reasonCode is string
                      && request.resource.data.reasonCode.size() > 0
                      && request.resource.data.reasonCode.size() <= 32
                      && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 240))
                      && request.resource.data.createdAt is int;

        allow update, delete: if false;
      }
    }

    // =====================================================================
    // LEGACY COMMUNITY FEEDS (v1)
    // NOTE: Legacy community_feeds documents lack authenticated ownerUid.
    // They do NOT provide owner-bound creation or deletion.
    // In v2 rules, legacy creation, update, and deletion are closed.
    // Legacy content remains readable to authenticated users.
    // =====================================================================
    match /community_feeds/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // =====================================================================
    // CARE ALERTS — Private distress signals partitioned by caller UID
    // =====================================================================
    match /care_alerts/{uid} {
      allow create: if request.auth != null
                    && uid == request.auth.uid
                    && request.resource.data.createdAt is int;

      allow read, update, delete: if false;
    }

    // =====================================================================
    // SPONSOR BUNDLES — Private clinical step-work bundles partitioned by UID
    // =====================================================================
    match /sponsor_bundles/{ownerUid} {
      allow create: if request.auth != null
                    && ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.bundle is string
                    && request.resource.data.sponsorCode is string;

      allow read: if request.auth != null && ownerUid == request.auth.uid;

      allow update, delete: if request.auth != null && ownerUid == request.auth.uid;
    }

    match /sponsorBundles/{sponsorUid}/inbox/{docId} {
      allow read: if request.auth != null && sponsorUid == request.auth.uid;

      allow create: if request.auth != null
                    && sponsorUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.bundle is string
                    && request.resource.data.sponsorCode is string;

      allow update: if request.auth != null
                    && sponsorUid == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'signed'
                    && request.resource.data.confirmation is string
                    && request.resource.data.bundle == resource.data.bundle
                    && request.resource.data.sponsorCode == resource.data.sponsorCode
                    && request.resource.data.sponseeAlias == resource.data.sponseeAlias
                    && request.resource.data.step == resource.data.step
                    && request.resource.data.title == resource.data.title
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null && sponsorUid == request.auth.uid;
    }
  }
}
